# Copy to .env. Never commit credentials. Node.js 24 LTS.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/truf
BETTER_AUTH_SECRET=GENERATE_A_RANDOM_SECRET
BETTER_AUTH_URL=http://localhost:3000
RESEND_API_KEY=
EMAIL_FROM=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=
OPS_TOKEN=
ROUTE_TEST_APPROVED=false
ROUTE_FEE_BEARER_CONFIRMED=
SEED_PASSWORD=
# Set automatically by the localhost launcher; never enable on a hosted deployment.
TRUF_LOCAL_MODE=false
